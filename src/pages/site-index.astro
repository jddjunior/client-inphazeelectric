---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout>
  <Fragment set:html={`
<x-dc>
<helmet>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script src="site-content.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800;900&family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
<style>
  body { margin:0; background:#0B0710; }
  a { color:#C9A5FF; text-decoration:none; }
  a:hover { color:#FFD400; }
  ::selection { background:#FFD400; color:#0B0710; }
  .urlRow { transition:background .12s ease; }
  .urlRow:hover { background:#150B24 !important; }
  @media (max-width:900px) {
    header > div { padding:12px 18px !important; }
    header img { height:34px !important; }
    section, footer { padding-left:18px !important; padding-right:18px !important; padding-top:48px !important; padding-bottom:48px !important; }
    .tierGrid { grid-template-columns:1fr !important; }
    .urlRow { grid-template-columns:1fr !important; gap:6px !important; }
    h1 { font-size:clamp(34px,9.5vw,58px) !important; }
    h2 { font-size:clamp(24px,7vw,38px) !important; }
  }
</style>
</helmet>

<div style="width:100%;max-width:1440px;margin:0 auto;background:#0B0710;color:#F7F4F2;font-family:Barlow,system-ui,sans-serif;overflow-x:clip">

<header style="position:sticky;top:0;z-index:60;background:rgba(11,7,16,0.9);backdrop-filter:blur(14px);border-bottom:1px solid #22132F">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 40px;flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:20px">
      <a href="In%20Phaze%20Homepage.dc.html" style="display:block;line-height:0"><img src="uploads/cropped-InPhaze-Electric-Medium.png" alt="In Phaze Electric" style="height:40px;width:auto;display:block" /></a>
      <div style="border-left:1px solid #2A1B3D;padding-left:20px">
        <div style="font-family:Archivo,sans-serif;font-weight:900;font-size:18px;letter-spacing:-0.03em">Site Index</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.2em;color:#A855F7">{{ totalLabel }}</div>
      </div>
    </div>
    <a href="tel:+14075997777" style="background:#FFD400;color:#0B0710;font-family:Archivo,sans-serif;font-weight:900;font-size:15px;padding:12px 20px">CALL (407) 599-7777</a>
  </div>
</header>

<section data-screen-label="Index hero" style="padding:72px 40px 56px;background:radial-gradient(110% 80% at 20% 0%, #3B1268 0%, #150B24 52%, #0B0710 100%)">
  <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;color:#9B87B8">IN PHAZE ELECTRIC &nbsp;/&nbsp; SITE ARCHITECTURE &nbsp;/&nbsp; BUILT</div>
  <h1 style="font-family:Archivo,sans-serif;font-weight:900;font-size:clamp(40px,6.6vw,92px);line-height:0.9;letter-spacing:-0.05em;margin:28px 0 0;max-width:1040px;text-wrap:balance">Every page in the plan, built and live.</h1>
  <p style="max-width:760px;margin:24px 0 0;font-size:20px;line-height:1.55;color:#CFC6DA">Each row is a real route with its own content — service ranges, local permitting, matched reviews. The three route templates render them from one content file, so a phone number changes in one place instead of {{ counts.total }} times.</p>
  <div style="display:flex;gap:1px;margin-top:40px;background:#22132F;border:1px solid #22132F;flex-wrap:wrap">
    <div style="background:#0B0710;padding:22px 26px;flex:1 1 160px">
      <div style="font-family:Archivo,sans-serif;font-weight:900;font-size:36px;line-height:1;color:#FFD400">{{ counts.total }}</div>
      <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;color:#9B87B8;margin-top:8px">TOTAL ROUTES</div>
    </div>
    <div style="background:#0B0710;padding:22px 26px;flex:1 1 160px">
      <div style="font-family:Archivo,sans-serif;font-weight:900;font-size:36px;line-height:1">{{ counts.core }}</div>
      <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;color:#9B87B8;margin-top:8px">TIER 1 · CORE + SUPPORT</div>
    </div>
    <div style="background:#0B0710;padding:22px 26px;flex:1 1 160px">
      <div style="font-family:Archivo,sans-serif;font-weight:900;font-size:36px;line-height:1">{{ counts.services }}</div>
      <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;color:#9B87B8;margin-top:8px">TIER 2 · MONEY</div>
    </div>
    <div style="background:#0B0710;padding:22px 26px;flex:1 1 160px">
      <div style="font-family:Archivo,sans-serif;font-weight:900;font-size:36px;line-height:1">{{ counts.cities }}</div>
      <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;color:#9B87B8;margin-top:8px">TIER 3 · GEO</div>
    </div>
    <div style="background:#0B0710;padding:22px 26px;flex:1 1 160px">
      <div style="font-family:Archivo,sans-serif;font-weight:900;font-size:36px;line-height:1">{{ counts.matrix }}</div>
      <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;color:#9B87B8;margin-top:8px">TIER 4 · MATRIX</div>
    </div>
  </div>
</section>

<section data-screen-label="Tier 1" style="padding:56px 40px 0;background:#0B0710">
  <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:18px">
    <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.2em;color:#FFD400">TIER 1 · CONVERSION</span>
    <h2 style="font-family:Archivo,sans-serif;font-weight:900;font-size:clamp(24px,3.4vw,42px);line-height:1;letter-spacing:-0.035em;margin:0">Core</h2>
  </div>
  <div style="display:grid;gap:1px;background:#22132F;border:1px solid #22132F">
    <sc-for list="{{ core }}" as="p">
      <a href="{{ p.href }}" class="urlRow" style="background:#0B0710;padding:20px 24px;display:grid;grid-template-columns:280px 1fr auto;gap:24px;align-items:center;color:#F7F4F2">
        <div style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:0.06em;color:#FFD400">{{ p.route }}</div>
        <div>
          <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:19px;letter-spacing:-0.02em">{{ p.title }}</div>
          <div style="font-size:16px;color:#8A8296;margin-top:4px">{{ p.note }}</div>
        </div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;color:#C9A5FF">OPEN →</div>
      </a>
    </sc-for>
  </div>
</section>

<section data-screen-label="Tier 2" style="padding:48px 40px 0;background:#0B0710">
  <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:18px">
    <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.2em;color:#FFD400">TIER 2 · MONEY PAGES</span>
    <h2 style="font-family:Archivo,sans-serif;font-weight:900;font-size:clamp(24px,3.4vw,42px);line-height:1;letter-spacing:-0.035em;margin:0">Services</h2>
    <span style="font-size:16px;color:#8A8296">Real price ranges, signs, day-of timeline, permits, eight FAQs each</span>
  </div>
  <div style="display:grid;gap:1px;background:#22132F;border:1px solid #22132F">
    <sc-for list="{{ services }}" as="p">
      <a href="{{ p.href }}" class="urlRow" style="background:#0B0710;padding:20px 24px;display:grid;grid-template-columns:280px 1fr auto;gap:24px;align-items:center;color:#F7F4F2">
        <div style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:0.06em;color:#FFD400">{{ p.route }}</div>
        <div>
          <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:19px;letter-spacing:-0.02em">{{ p.title }}</div>
          <div style="font-size:16px;color:#8A8296;margin-top:4px">{{ p.note }}</div>
        </div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;color:#C9A5FF;white-space:nowrap">{{ p.price }}</div>
      </a>
    </sc-for>
  </div>
</section>

<section data-screen-label="Tier 3" style="padding:48px 40px 0;background:#0B0710">
  <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:18px">
    <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.2em;color:#FFD400">TIER 3 · GEO</span>
    <h2 style="font-family:Archivo,sans-serif;font-weight:900;font-size:clamp(24px,3.4vw,42px);line-height:1;letter-spacing:-0.035em;margin:0">Cities</h2>
    <span style="font-size:16px;color:#8A8296">Local housing stock, utility, permit office, matched local reviews</span>
  </div>
  <div style="display:grid;gap:1px;background:#22132F;border:1px solid #22132F">
    <sc-for list="{{ cities }}" as="p">
      <a href="{{ p.href }}" class="urlRow" style="background:#0B0710;padding:20px 24px;display:grid;grid-template-columns:280px 1fr auto;gap:24px;align-items:center;color:#F7F4F2">
        <div style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:0.06em;color:#FFD400">{{ p.route }}</div>
        <div>
          <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:19px;letter-spacing:-0.02em">{{ p.title }}</div>
          <div style="font-size:16px;color:#8A8296;margin-top:4px">{{ p.note }}</div>
        </div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;color:#C9A5FF;white-space:nowrap">{{ p.price }}</div>
      </a>
    </sc-for>
  </div>
</section>

<section data-screen-label="Tier 4" style="padding:48px 40px 0;background:#0B0710">
  <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:18px">
    <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.2em;color:#FFD400">TIER 4 · SERVICE × CITY</span>
    <h2 style="font-family:Archivo,sans-serif;font-weight:900;font-size:clamp(24px,3.4vw,42px);line-height:1;letter-spacing:-0.035em;margin:0">The matrix</h2>
    <span style="font-size:16px;color:#8A8296">Only where volume justifies it — never auto-spun</span>
  </div>
  <div style="display:grid;gap:1px;background:#22132F;border:1px solid #22132F">
    <sc-for list="{{ matrix }}" as="p">
      <a href="{{ p.href }}" class="urlRow" style="background:#0B0710;padding:20px 24px;display:grid;grid-template-columns:280px 1fr auto;gap:24px;align-items:center;color:#F7F4F2">
        <div style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:0.06em;color:#FFD400">{{ p.route }}</div>
        <div>
          <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:19px;letter-spacing:-0.02em">{{ p.title }}</div>
          <div style="font-size:16px;color:#8A8296;margin-top:4px">{{ p.note }}</div>
        </div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;color:#C9A5FF">OPEN →</div>
      </a>
    </sc-for>
  </div>
</section>

<section data-screen-label="Internal" style="padding:48px 40px 0;background:#0B0710">
  <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:18px">
    <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.2em;color:#F87171">INTERNAL · NOT PUBLIC</span>
    <h2 style="font-family:Archivo,sans-serif;font-weight:900;font-size:clamp(24px,3.4vw,42px);line-height:1;letter-spacing:-0.035em;margin:0">Back of house</h2>
  </div>
  <div class="tierGrid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#22132F;border:1px solid #22132F">
    <a href="In%20Phaze%20CRM.dc.html" class="urlRow" style="background:#0B0710;padding:24px 26px;display:block;color:#F7F4F2">
      <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#FFD400">/lead-desk</div>
      <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:20px;margin:10px 0 6px;letter-spacing:-0.02em">Lead Desk CRM</div>
      <div style="font-size:16px;line-height:1.5;color:#8A8296">Lead inbox, media library, call tracking with sentiment, Housecall Pro webhook</div>
    </a>
    <a href="In%20Phaze%20Brand%20Kit.dc.html" class="urlRow" style="background:#0B0710;padding:24px 26px;display:block;color:#F7F4F2">
      <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#FFD400">/brand-kit</div>
      <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:20px;margin:10px 0 6px;letter-spacing:-0.02em">Brand system</div>
      <div style="font-size:16px;line-height:1.5;color:#8A8296">Positioning, voice, logo, color, type, fleet livery, proof system</div>
    </a>
    <a href="In%20Phaze%20Image%20Prompt%20Kit.dc.html" class="urlRow" style="background:#0B0710;padding:24px 26px;display:block;color:#F7F4F2">
      <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#FFD400">/prompt-kit</div>
      <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:20px;margin:10px 0 6px;letter-spacing:-0.02em">Image &amp; copy prompt kit</div>
      <div style="font-size:16px;line-height:1.5;color:#8A8296">The locked style block, negative prompt, ten asset recipes, voice prompt</div>
    </a>
    <a href="In%20Phaze%20SEO%20Architecture.dc.html" class="urlRow" style="background:#0B0710;padding:24px 26px;display:block;color:#F7F4F2">
      <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#FFD400">/seo-plan</div>
      <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:20px;margin:10px 0 6px;letter-spacing:-0.02em">SEO architecture</div>
      <div style="font-size:16px;line-height:1.5;color:#8A8296">The plan these pages were built from, plus the content engine</div>
    </a>
  </div>
</section>

<section data-screen-label="Before publish" style="padding:56px 40px 72px;background:#0B0710">
  <div style="border:1px solid #22132F;padding:32px 34px">
    <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.16em;color:#FFD400">BEFORE THESE GO LIVE</div>
    <div class="tierGrid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:22px">
      <div>
        <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:19px">Confirm utility &amp; permit office</div>
        <p style="margin:7px 0 0;font-size:16px;line-height:1.55;color:#A99BBD">Each city page names one of each. They are the two facts Google rewards for accuracy and the two most likely to be stale — have the office verify per address.</p>
      </div>
      <div>
        <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:19px">Swap placeholders for real photos</div>
        <p style="margin:7px 0 0;font-size:16px;line-height:1.55;color:#A99BBD">Every job card and banner is a marked placeholder. One day of shooting trucks, crews and panels replaces all of them and beats anything generated.</p>
      </div>
      <div>
        <div style="font-family:Archivo,sans-serif;font-weight:800;font-size:19px">Fix the citation mismatch first</div>
        <p style="margin:7px 0 0;font-size:16px;line-height:1.55;color:#A99BBD">Three addresses and two phone numbers are live across Yelp, Manta, HomeAdvisor and BBB. Inconsistent NAP suppresses local rank — it is the cheapest win on the list.</p>
      </div>
    </div>
  </div>
</section>

<footer style="padding:28px 40px 40px;background:#0B0710;border-top:1px solid #22132F;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.12em;color:#6B6277">
  <span>© 2026 IN PHAZE ELECTRIC INC. · LIC. #ER13014534 · (407) 599-7777</span>
  <span>{{ totalLabel }}</span>
</footer>

</div>

</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  componentDidMount() {
    if (!window.InPhazeContent) {
      this._poll = setInterval(() => { if (window.InPhazeContent) { clearInterval(this._poll); this.forceUpdate(); } }, 120);
    }
  }
  componentWillUnmount() { if (this._poll) clearInterval(this._poll); }

  static CORE = [
    { route: '/', title: 'Homepage', note: 'Cinematic sticky hero, proof wall, before/after gallery, crew, service area', href: 'In%20Phaze%20Homepage.dc.html' },
    { route: '/reviews', title: 'All 801 reviews', note: 'Filterable by platform and service, rating breakdown, recovery protocol', href: 'In%20Phaze%20Reviews.dc.html' },
    { route: '/crew', title: 'The crew', note: 'Named electricians with review counts — customers ask for them by name', href: 'In%20Phaze%20Crew.dc.html' },
    { route: '/about', title: 'About Tony', note: 'Navy veteran, 30 years, the honest-estimate habit, credentials', href: 'In%20Phaze%20About.dc.html' },
    { route: '/contact', title: 'Contact', note: 'Tap-to-call, urgency triage, estimate form with real photo upload', href: 'In%20Phaze%20Contact.dc.html' },
    { route: '/cost', title: 'What it costs', note: 'Full published price list, what moves the number, how to read a cheaper quote', href: 'In%20Phaze%20Cost.dc.html' },
    { route: '/careers', title: 'Careers', note: 'Three open roles, hiring process, application with work-photo upload', href: 'In%20Phaze%20Careers.dc.html' },
    { route: '/electricista-orlando', title: 'Electricista en Orlando', note: 'Spanish track — services, proof, and an estimate form written in Spanish', href: 'In%20Phaze%20Electricista.dc.html' }
  ];

  renderVals() {
    const C = window.InPhazeContent;
    if (!C) {
      return { core: Component.CORE, services: [], cities: [], matrix: [], counts: { total: 0, core: 5, services: 0, cities: 0, matrix: 0 }, totalLabel: 'LOADING…' };
    }
    const services = C.SERVICES.map(s => ({
      route: '/' + s.slug,
      title: s.nav,
      note: s.lede.split('.')[0] + '.',
      price: s.priceRange.toUpperCase(),
      href: 'In%20Phaze%20Service%20Page.dc.html?p=' + s.slug
    }));
    const cities = C.CITIES.map(c => ({
      route: '/' + c.slug,
      title: c.name,
      note: c.county + ' · ' + c.utility.split(/[;(]/)[0].trim(),
      price: c.reviews + ' REVIEWS',
      href: 'In%20Phaze%20City%20Page.dc.html?p=' + c.slug
    }));
    const matrix = C.MATRIX.map(m => ({
      route: '/' + m.slug,
      title: m.h1.replace(/ in .*/, '') + ' — ' + C.cityMap[m.city].name,
      note: m.lede.split('.')[0] + '.',
      href: 'In%20Phaze%20Matrix%20Page.dc.html?p=' + m.slug
    }));
    const total = Component.CORE.length + services.length + cities.length + matrix.length;
    return {
      core: Component.CORE,
      services, cities, matrix,
      counts: { total, core: Component.CORE.length, services: services.length, cities: cities.length, matrix: matrix.length },
      totalLabel: total + ' ROUTES BUILT'
    };
  }
}
</script>
`} />
</Layout>
