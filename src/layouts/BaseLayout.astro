---
interface Props {
  title?: string;
}

const { title = 'In Phaze Electric' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <script is:inline src="/support.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800;900&family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body { margin:0; background:#0B0710; --headerH:94px; }
    a { color:#C9A5FF; text-decoration:none; }
    a:hover { color:#FFD400; }
    header nav a, header a[href^="tel"] { white-space:nowrap; }
    ::selection { background:#FFD400; color:#0B0710; }
    @keyframes riseIn { from { opacity:0; transform:translateY(48px); } to { opacity:1; transform:translateY(0); } }
    @keyframes wipeIn { from { clip-path:inset(0 100% 0 0); } to { clip-path:inset(0 0 0 0); } }
    @keyframes growLine { from { transform:scaleX(0); } to { transform:scaleX(1); } }
    @keyframes heroDrift { from { transform:scale(1.14) translateY(0); } to { transform:scale(1) translateY(-40px); } }
    body.heroOn .rise { animation:riseIn 1s linear both paused; animation-delay:calc(var(--p,0) * -1s); }
    body.heroOn .wipe { animation:wipeIn 1s linear both paused; animation-delay:calc(var(--p,0) * -1s); }
    body.heroOn .line { transform-origin:left center; animation:growLine 1s linear both paused; animation-delay:calc(var(--p,0) * -1s); }
    
    /* cinematic sticky hero */
    body.heroOn .hx { animation-duration:1s; animation-timing-function:linear; animation-fill-mode:both; animation-play-state:paused; animation-delay:calc(var(--p,0) * -1s); }
    @keyframes gridRun { to { background-position:0 96px, 0 0; } }
    @keyframes gridRunTop { to { background-position:0 -96px, 0 0; } }
    @keyframes floorPush { 0%,22% { transform:perspective(620px) rotateX(80deg) scale(1.5) translateY(6%); opacity:.55 } 53% { transform:perspective(620px) rotateX(70deg) scale(1.15) translateY(0); opacity:1 } 100% { transform:perspective(620px) rotateX(62deg) scale(1) translateY(-6%); opacity:.9 } }
    @keyframes ceilPush { 0%,22% { transform:perspective(620px) rotateX(-80deg) scale(1.5) translateY(-6%); opacity:.3 } 53% { transform:perspective(620px) rotateX(-70deg) scale(1.15) translateY(0); opacity:.65 } 100% { transform:perspective(620px) rotateX(-62deg) scale(1) translateY(6%); opacity:.5 } }
    @keyframes hznGrow { 0%,22% { transform:scaleX(.10); opacity:.55 } 45% { transform:scaleX(.16); opacity:.8 } 56% { transform:scaleX(.34); opacity:1 } 63% { transform:scaleX(.62); opacity:1 } 100% { transform:scaleX(1); opacity:.95 } }
    @keyframes guyAbsorb { 0%,45% { opacity:1; transform:none } 53% { opacity:1; transform:translateY(1%) scaleX(1.04) scaleY(.62) } 59% { opacity:.75; transform:translateY(2%) scaleX(1.2) scaleY(.18) } 63%,100% { opacity:0; transform:translateY(2%) scaleX(1.4) scaleY(0) } }
    @keyframes smokeRise { 0% { opacity:0; transform:translateY(0) translateX(0) scale(.5) } 18% { opacity:.55 } 100% { opacity:0; transform:translateY(-110px) translateX(14px) scale(1.7) } }
    @keyframes zap { 0%,20% { opacity:0; transform:scale(.5) rotate(var(--r,0deg)) } 24% { opacity:1; transform:scale(1.12) rotate(var(--r,0deg)) } 28% { opacity:.15; transform:scale(.92) rotate(var(--r,0deg)) } 32% { opacity:.95; transform:scale(1.06) rotate(var(--r,0deg)) } 36% { opacity:.2; transform:scale(.95) rotate(var(--r,0deg)) } 40% { opacity:1; transform:scale(1.14) rotate(var(--r,0deg)) } 44% { opacity:.18; transform:scale(.9) rotate(var(--r,0deg)) } 48% { opacity:1; transform:scale(1.1) rotate(var(--r,0deg)) } 52% { opacity:.25; transform:scale(.96) rotate(var(--r,0deg)) } 56% { opacity:1; transform:scale(1.18) rotate(var(--r,0deg)) } 60% { opacity:.9; transform:scale(1.05) rotate(var(--r,0deg)) } 63%,100% { opacity:0; transform:scale(.6) rotate(var(--r,0deg)) } }
    @keyframes jolt { 0%,26% { transform:translate(0,0) rotate(0deg) } 30% { transform:translate(-4px,-2px) rotate(-1.4deg) } 34% { transform:translate(5px,1px) rotate(1.6deg) } 38% { transform:translate(-6px,-3px) rotate(-2deg) } 42% { transform:translate(6px,2px) rotate(1.8deg) } 46% { transform:translate(-7px,-2px) rotate(-2.2deg) } 50% { transform:translate(7px,3px) rotate(2.4deg) } 54% { transform:translate(-5px,-1px) rotate(-1.6deg) } 58%,100% { transform:translate(0,0) rotate(0deg) } }
    @keyframes hairStand { 0%,30% { transform:scaleY(1) } 44% { transform:scaleY(1.06) } 52% { transform:scaleY(1.02) } 60%,100% { transform:scaleY(1) } }
    @keyframes bodyGlow { 0%,18% { filter:drop-shadow(0 0 34px rgba(123,47,247,0.5)) contrast(1.05) saturate(1.05) } 40% { filter:drop-shadow(0 0 22px rgba(255,212,0,0.95)) brightness(1.5) contrast(1.2) saturate(1.3) } 47% { filter:drop-shadow(0 0 40px rgba(201,165,255,0.9)) brightness(1.1) contrast(1.1) saturate(1.1) } 54% { filter:drop-shadow(0 0 26px rgba(255,255,255,1)) brightness(1.85) contrast(1.3) saturate(.6) } 62%,100% { filter:drop-shadow(0 0 34px rgba(123,47,247,0.5)) contrast(1.05) saturate(1.05) } }
    @keyframes arcBolt { 0%,30% { opacity:0; clip-path:inset(0 0 100% 0) } 36% { opacity:1; clip-path:inset(0 0 0 0) } 40% { opacity:.15 } 44% { opacity:1 } 50% { opacity:.3 } 56% { opacity:1 } 64%,100% { opacity:0; clip-path:inset(100% 0 0 0) } }
    @keyframes ember { 0%,20% { opacity:0; transform:translate(0,0) scale(.4) } 26% { opacity:1; transform:translate(calc(var(--dx,10px) * .4), calc(var(--dy,-30px) * .3)) scale(1) } 100% { opacity:0; transform:translate(var(--dx,10px), var(--dy,-30px)) scale(.2) } }
    @keyframes ringPulse { 0%,22% { opacity:0; transform:translate(-50%,-50%) scale(.2) } 30% { opacity:.9; transform:translate(-50%,-50%) scale(1) } 40% { opacity:.15; transform:translate(-50%,-50%) scale(1.5) } 44% { opacity:0; transform:translate(-50%,-50%) scale(.3) } 52% { opacity:.85; transform:translate(-50%,-50%) scale(1.1) } 62%,100% { opacity:0; transform:translate(-50%,-50%) scale(2.1) } }
    @keyframes sparkCrackle { 0%,100% { opacity:.25 } 12% { opacity:1 } 20% { opacity:.4 } 28% { opacity:.95 } 44% { opacity:.3 } 60% { opacity:1 } 76% { opacity:.5 } }
    @keyframes absorbFlash { 0%,50% { opacity:0; transform:translate(-50%,-50%) scale(.3,.4) } 59% { opacity:1; transform:translate(-50%,-50%) scale(1,1) } 73%,100% { opacity:0; transform:translate(-50%,-50%) scale(1.8,.25) } }
    @keyframes glowBloom { 0%,22% { opacity:.25; transform:scale(.7) } 57% { opacity:1; transform:scale(1) } 100% { opacity:.7; transform:scale(1.25) } }
    @keyframes titleSettle { 0%,61% { opacity:0; transform:translateY(38px) scale(1.05) } 74%,100% { opacity:1; transform:translateY(0) scale(1) } }
    @keyframes subIn { 0%,69% { opacity:0; transform:translateY(24px) } 80%,100% { opacity:1; transform:translateY(0) } }
    @keyframes ctaIn { 0%,75% { opacity:0; transform:translateY(26px) } 86%,100% { opacity:1; transform:translateY(0) } }
    @keyframes payoffIn { 0%,72% { opacity:0; transform:translateY(30px) } 85%,100% { opacity:1; transform:translateY(0) } }
    @keyframes stripeWipe { 0%,58% { clip-path:inset(0 100% 0 0) } 75%,100% { clip-path:inset(0 0 0 0) } }
    @keyframes ticksIn { 0%,30% { opacity:0 } 45% { opacity:1 } 100% { opacity:.35 } }
    @keyframes scrollHint { 0%,22% { opacity:1 } 36%,100% { opacity:0 } }
    @keyframes arcFlicker { 0%,100% { opacity:.9 } 42% { opacity:.35 } 46% { opacity:1 } 51% { opacity:.5 } 55% { opacity:.95 } }
    @keyframes dotCrawl { to { transform:translateY(-96px) } }
    @keyframes sparkPop { 0%,21% { opacity:0; transform:scale(.2) } 25% { opacity:1; transform:scale(1.25) } 30% { opacity:.2; transform:scale(.8) } 36% { opacity:1; transform:scale(1.1) } 42% { opacity:.15; transform:scale(.75) } 48% { opacity:1; transform:scale(1.3) } 54% { opacity:.25; transform:scale(.85) } 59% { opacity:1; transform:scale(1.15) } 63%,100% { opacity:0; transform:scale(.4) } }
    @keyframes spit { 0%,20% { opacity:0; transform:translate(0,0) scale(.3) } 24% { opacity:1; transform:translate(calc(var(--sx,20px) * .35), calc(var(--sy,-26px) * .35)) scale(1) } 62% { opacity:0; transform:translate(var(--sx,20px),var(--sy,-26px)) scale(.15) } 100% { opacity:0 } }
    @keyframes sparkFly { 0% { opacity:0; transform:translate(0,0) scale(.4) } 12% { opacity:1 } 100% { opacity:0; transform:translate(var(--sx,40px),var(--sy,-70px)) scale(.15) }  }
    @keyframes zapBlink { 0%,42% { opacity:0 } 47% { opacity:1 } 52% { opacity:.15 } 57% { opacity:.95 } 63% { opacity:0 } 100% { opacity:0 } }
    @keyframes boltJitter { 0%,100% { transform:translate(0,0) rotate(0deg) } 25% { transform:translate(-2px,1px) rotate(-3deg) } 50% { transform:translate(2px,-1px) rotate(2deg) } 75% { transform:translate(-1px,-2px) rotate(-1deg) } }
    @keyframes guyShake { 0%,20% { transform:translate(0,0) } 23% { transform:translate(-4px,1px) } 26% { transform:translate(4px,-1px) } 29% { transform:translate(-3px,-2px) } 33% { transform:translate(3px,2px) } 37% { transform:translate(-4px,1px) } 41% { transform:translate(4px,2px) } 45% { transform:translate(-3px,-1px) } 49% { transform:translate(3px,-2px) } 53% { transform:translate(-4px,2px) } 57% { transform:translate(3px,1px) } 61% { transform:translate(-2px,0) } 64%,100% { transform:translate(0,0) } }
    @keyframes envFlash { 0%,18% { opacity:0 } 22% { opacity:.45 } 25% { opacity:.03 } 29% { opacity:.55 } 33% { opacity:.06 } 38% { opacity:.5 } 42% { opacity:.04 } 47% { opacity:.62 } 51% { opacity:.08 } 56% { opacity:.55 } 60% { opacity:.3 } 64%,100% { opacity:0 } }
    @keyframes floorArc { 0%,38% { opacity:0; transform:scaleX(.2) } 46% { opacity:.9; transform:scaleX(1) } 53% { opacity:.2; transform:scaleX(.7) } 59% { opacity:1; transform:scaleX(1.1) } 66%,100% { opacity:0; transform:scaleX(.4) } }
    @keyframes railCrackle { 0%,14% { opacity:0 } 17% { opacity:1 } 20% { opacity:.12 } 23% { opacity:.9 } 26% { opacity:.2 } 29% { opacity:1 } 32% { opacity:.1 } 35% { opacity:.85 } 38% { opacity:.25 } 41% { opacity:1 } 44% { opacity:.15 } 47% { opacity:.95 } 50% { opacity:.2 } 53% { opacity:1 } 56% { opacity:.3 } 59% { opacity:1 } 62% { opacity:.5 } 64%,100% { opacity:0 } }
    @keyframes driftEmber { 0% { opacity:0; transform:translate(0,0) scale(.4) } 8% { opacity:1 } 100% { opacity:0; transform:translate(var(--ex,30px),var(--ey,-160px)) scale(.1) } }
    @keyframes groundRipple { 0%,44% { opacity:0; transform:translate(-50%,-50%) scale(.3) } 54% { opacity:.8; transform:translate(-50%,-50%) scale(1) } 70%,100% { opacity:0; transform:translate(-50%,-50%) scale(1.9) } }
    @keyframes arcCrackle { 0%,100% { opacity:.25; transform:scaleX(.6) } 30% { opacity:.9; transform:scaleX(1) } 55% { opacity:.15; transform:scaleX(.8) } 78% { opacity:1; transform:scaleX(1.1) } }
    @media (prefers-reduced-motion: reduce) { .hx { animation:none !important; opacity:1 !important; transform:none !important; clip-path:none !important; } .guyLayer, .sparkLayer { display:none !important; } }
    @supports not (animation-timeline: view()) { .guyLayer, .sparkLayer { display:none !important; } }

    /* tap-to-call bar: mobile only */
    .callBar { display:none !important; }
    @media (max-width:900px) { .callBar { display:flex !important; } }

    /* gallery */
    .galThumb { position:relative; cursor:pointer; overflow:hidden; background:#150B24; border:1px solid #2A1B3D; transition:border-color .15s ease, transform .15s ease; }
    .galThumb:hover { border-color:#FFD400; transform:translateY(-2px); }
    .galThumb[data-active="1"] { border-color:#FFD400; }
    .galNav { cursor:pointer; user-select:none; transition:background .15s ease, color .15s ease; }
    .galNav:hover { background:#FFD400 !important; color:#0B0710 !important; }
    .galStage { cursor:ew-resize; touch-action:pan-y; }

    /* service cards — hover must recolor children, not just the card */
    .svcCard { transition:background .18s ease; }
    .svcCard:hover { background:#0B0710 !important; }
    .svcCard:hover .svcEyebrow { color:#FFD400 !important; }
    .svcCard:hover .svcTitle { color:#FFFFFF !important; }
    .svcCard:hover .svcBody { color:#CFC6DA !important; }
    .svcCard:hover .svcCta { color:#FFD400 !important; }

    /* mobile */
    @media (max-height:640px) {
      section[data-screen-label="Hero"] h1 { font-size:clamp(30px,6.4vw,52px) !important; }
      section[data-screen-label="Hero"] p { font-size:15px !important; margin-top:10px !important; }
      section[data-screen-label="Hero"] .heroCopy { padding-top:20px !important; padding-bottom:clamp(104px,20vh,140px) !important; }
    }
  </style>
</head>
<body>
  <slot />
  <script is:inline src="/lead-store.js"></script>
  <script is:inline src="/site-content.js"></script>
</body>
</html>

